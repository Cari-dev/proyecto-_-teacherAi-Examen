# Configuración general
APP_NAME=TeacherAI
APP_VERSION=0.1.0
ENVIRONMENT=development

# Base de datos SQLite. La ruta relativa se resuelve dentro de backend/.
DATABASE_URL=sqlite:///./teacherai.db

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nombre mostrado en el dashboard
TEACHER_NAME=Docente

# Datos de ejemplo claramente identificados como "Demostración"
SEED_DEMO_DATA=true

# Integración opcional con Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash